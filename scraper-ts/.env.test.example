# Test Environment Variables
# Copy this file to .env and fill with your credentials for testing

# Barchart Credentials (Required)
BARCHART_EMAIL=your-email@example.com
BARCHART_PASSWORD=your-password

# Barchart URLs
BARCHART_LOGIN_URL=https://www.barchart.com/login
BARCHART_SCREENER_URL=https://www.barchart.com/stocks/stocks-screener?viewName=filter_view&screener=478448

# Test Settings
TEST_HEADLESS=true  # Set to 'false' to see browser during tests
