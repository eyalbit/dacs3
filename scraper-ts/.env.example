# Browser Configuration
SCRAPER_HEADLESS=true
SCRAPER_SLOW_MO=0
SCRAPER_BROWSER=chromium
SCRAPER_VIEWPORT_WIDTH=1920
SCRAPER_VIEWPORT_HEIGHT=1080

# Data Source URLs (customize for your site)
OPTIONS_DATA_URL=https://example.com/options/{symbol}

# Output Configuration
OUTPUT_DIR=../assets

# Timeouts (milliseconds)
DEFAULT_TIMEOUT=30000
LOAD_TIMEOUT=60000

# Barchart Authentication
BARCHART_EMAIL=your-email@example.com
BARCHART_PASSWORD=your-password
BARCHART_LOGIN_URL=https://www.barchart.com/login
BARCHART_SCREENER_URL=https://www.barchart.com/stocks/stocks-screener?viewName=filter_view&screener=478448
