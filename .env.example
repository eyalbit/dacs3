# Gemini API Configuration
# Copy this file to .env and fill in your API key

GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest

# To get your API key:
# 1. Go to https://ai.google.dev/
# 2. Click "Get API Key"
# 3. Copy your key and paste it above

# Email Configuration (for sending HTML reports)
# IMPORTANT: Use Gmail App Password, not your regular password
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your-app-password-here

# SEND_EMAIL - Controls whether emails are sent
# Set to 1 to ENABLE email sending (for GitHub Actions)
# Set to 0 to DISABLE email sending (for local testing)
# Default: 0 (disabled for local runs)
SEND_EMAIL=0

# Barchart Screener Configuration
# Get your screener URL from: https://www.barchart.com/my/screeners
# Example: https://www.barchart.com/screener/stocks/67f3f0cf45
BARCHART_EMAIL=your-barchart-email@example.com
BARCHART_PASSWORD=your-barchart-password
BARCHART_SCREENER_URL=https://www.barchart.com/screener/stocks/your-screener-id
BARCHART_LOGIN_URL=https://www.barchart.com/login

# Scraper Configuration (Playwright)
SCRAPER_HEADLESS=true
SCRAPER_SLOW_MO=0
